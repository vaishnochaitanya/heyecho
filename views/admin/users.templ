package admin

import (
"vchan.in/heyecho/views/layout"
"vchan.in/heyecho/views/components/admin"
"vchan.in/heyecho/types"
)

templ Users(role string, users []types.User) {
@layout.Base(role) {
<div class="grid rounded-lg h-auto mb-4">
    <h5 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Users</h5>
    <p class="font-normal text-gray-700 dark:text-gray-400">Manage users and their roles</p>
</div>

<div class="grid rounded-lg h-auto mb-4">
    <div class="relative overflow-x-auto shadow-md rounded-lg">
        <div
            class="flex items-center justify-between flex-column md:flex-row flex-wrap space-y-4 md:space-y-0 py-4 bg-white dark:bg-gray-900 p-4">

            <label for="table-search" class="sr-only">Search</label>
            <div class="relative">
                <div class="absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z" />
                    </svg>
                </div>
                <input type="text" id="table-search-users"
                    class="block pt-2 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg w-80 bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                    placeholder="Search for users">
            </div>
            <div>
                <a type="button" href="#" id="addUser" data-modal-target="userModal" data-modal-show="userModal"
                    class="px-5 py-2.5 text-sm font-medium text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 rounded-lg text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                    <svg class="w-3.5 h-3.5 text-white me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                        width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd"
                            d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm11-4.243a1 1 0 1 0-2 0V11H7.757a1 1 0 1 0 0 2H11v3.243a1 1 0 1 0 2 0V13h3.243a1 1 0 1 0 0-2H13V7.757Z"
                            clip-rule="evenodd" />
                    </svg>
                    Add User
                </a>
            </div>
        </div>
        <table id="users" class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="px-6 py-3">
                        Name
                    </th>
                    <th scope="col" class="px-6 py-3">
                        Role
                    </th>
                    <th scope="col" class="px-6 py-3">
                        Date Added
                    </th>
                    <th scope="col" class="px-6 py-3">
                        Action
                    </th>
                </tr>
            </thead>
            <tbody id="users-list">
                for _, item := range users {
                    <tr
                        class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                        <input type="hidden" name="uuid" value={item.Uuid}>
                        <th scope="row" class="flex items-center px-6 py-4 text-gray-900 whitespace-nowrap dark:text-white">
                            <img class="w-10 h-10 rounded-full" src={item.GeneratedPhoto} alt="avatar">
                            <div class="ps-3">
                                <div id="name" class="text-base font-semibold">{item.Name}</div>
                                <div id="email" class="font-normal text-gray-500">{item.Email}</div>
                            </div>
                        </th>
                        <td id="role" class="px-6 py-4">
                            {item.Role}
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                {item.CreatedAt}
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <!-- Modal toggle -->
                            <a href="#" type="button"
                                data-modal-target="userModal" data-modal-show="userModal"
                                class="edit-user font-medium text-blue-600 dark:text-blue-500 hover:underline">Edit user</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div
            class="flex items-center justify-between flex-column md:flex-row flex-wrap space-y-4 md:space-y-0 py-4 bg-white dark:bg-gray-900 p-4">
            <div>
                <p id="entries-info">Showing 1 to 5 of 5 entries</p>
            </div>
            <nav aria-label="users pagination">
                <ul class="inline-flex -space-x-px text-base h-10" id="custom-pagination"></ul>
            </nav>
        </div>
        <!-- Edit user modal -->
        @components.UserModal()
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
    <div class="border-2 border-dashed border-gray-300 rounded-lg dark:border-gray-600 h-32 md:h-64"></div>
    <div class="border-2 border-dashed rounded-lg border-gray-300 dark:border-gray-600 h-32 md:h-64"></div>
    <div class="border-2 border-dashed rounded-lg border-gray-300 dark:border-gray-600 h-32 md:h-64"></div>
    <div class="border-2 border-dashed rounded-lg border-gray-300 dark:border-gray-600 h-32 md:h-64"></div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var dTable = $('#users').DataTable({
            "dom": 'rt',
            "pageLength": 10,
        });

        $('#table-search-users').keyup(function () {
            dTable.search($(this).val()).draw();
        });

        // Function to generate custom pagination dynamically
        function generateCustomPagination() {
            var pageCount = dTable.page.info().pages;
            var currentPage = dTable.page.info().page;
            var paginationContainer = $('#custom-pagination');
            var previousPage = "flex items-center justify-center px-4 h-10 ms-0 leading-tight text-gray-500 bg-white border border-e-0 border-gray-300 rounded-s-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
            var activePage = "flex items-center justify-center px-4 h-10 text-blue-600 border border-gray-300 bg-blue-50 hover:bg-blue-100 hover:text-blue-700 dark:border-gray-700 dark:bg-gray-700 dark:text-white"
            var inactivePage = "flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
            var nextPage = "flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 rounded-e-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"

            // Clear existing pagination links
            paginationContainer.empty();

            // Previous button
            var prevClass = currentPage === 0 ? previousPage : previousPage;
            paginationContainer.append('<li href="#"><a class="' + prevClass + '" tabindex="-1" aria-disabled="true">Previous</a></li>');

            // Page buttons
            if (pageCount <= 5) {
                // Display all pages if the total number is 5 or less
                for (var i = 0; i < pageCount; i++) {
                    var activeClass = i === currentPage ? activePage : inactivePage;
                    paginationContainer.append('<li><a class="' + activeClass + '" data-page="' + i + '">' + (i + 1) + '</a></li>');
                }
            } else {
                // Display first four pages
                for (var i = 0; i < 4; i++) {
                    var activeClass = i === currentPage ? activePage : inactivePage;
                    paginationContainer.append('<li><a class="' + activeClass + '" data-page="' + i + '">' + (i + 1) + '</a></li>');
                }

                // Display ellipsis
                paginationContainer.append('<li class="disabled"><a class="flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 rounded-e-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">...</a></li>');

                // Display last two pages
                for (var i = pageCount - 2; i < pageCount; i++) {
                    var activeClass = i === currentPage ? activePage : inactivePage;
                    paginationContainer.append('<li><a class="' + activeClass + '" data-page="' + i + '">' + (i + 1) + '</a></li>');
                }
            }

            // Next button
            var nextClass = currentPage === pageCount - 1 ? nextPage : nextPage;
            paginationContainer.append('<li href="#"><a class="' + nextClass + '">Next</a></li>');
        }

        // Initial pagination generation
        generateCustomPagination();

        // Redraw pagination on page change
        dTable.on('draw', function () {
            generateCustomPagination();
            updateEntriesInfo();
        });

        // Handle pagination click
        $('#custom-pagination').on('click', 'li', function () {
            var text = $(this).text().trim();
            if (text === 'Previous') {
                dTable.page('previous').draw('page');
            } else if (text === 'Next') {
                dTable.page('next').draw('page');
            } else {
                var page = $(this).find('a').data('page');
                dTable.page(page).draw('page');
            }
        });

        // Function to update entries information
        function updateEntriesInfo() {
            var pageInfo = dTable.page.info();
            $('#entries-info').html('Showing <span>' + (pageInfo.start + 1) + '</span> to <span>' + pageInfo.end + '</span> of <span>' + pageInfo.recordsTotal + '</span> entries');
        }

        // Initial entries information update
        updateEntriesInfo();

        // Edit user modal using event delegation
        $(document).on('click', '.edit-user', function () {
            var row = $(this).closest('tr');
            var uuid = row.find('input[name="uuid"]').val();
            var name = row.find('#name').text();
            var email = row.find('#email').text();
            var role = row.find('#role').text();

            $('#userModal').find('form').trigger('reset');                  // Reset form fields
            $('#userModal').find('.text-xl').text('Edit user');             // Replace modal title
            $('#userModal').find('button[type="submit"]').text('Update');   // Replace Update button with Add button
            $('#userModal').find('#password').removeAttr('required');       // Remove required attribute from password field

            $('#userModal').find('#uuid').val(uuid);
            $('#userModal').find('#name').val(name);
            $('#userModal').find('#email').val(email);
            if (role === 'admin') {
                $('#userModal').find('#radio-role-admin').prop('checked', true);
            } else {
                $('#userModal').find('#radio-role-user').prop('checked', true);
            }
        });

        // Add user modal
        $('#addUser').on('click', function () {
            $('#userModal').find('form').trigger('reset');                  // Reset form fields
            $('#userModal').find('.text-xl').text('Add user');              // Replace Modal title   
            $('#userModal').find('button[type="submit"]').text('Add user'); // Replace Update button with Add button
            $('#userModal').find('#password').attr('required', 'required'); // Add required attribute to password field
            $('#userModal').find('#radio-role-user').prop('checked', true); // Default radio button to user role
        });

    });
</script>

}
}