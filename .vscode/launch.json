{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug With Make",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "preLaunchTask": "build-with-make", // Changed from "run" to "build-with-make"
            "env": {"GOFLAGS": "-v"},
            "args": [],
            "showLog": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Current File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "env": {"GOFLAGS": "-v"},
            "args": [],
            "showLog": true
        },
        {
            "name": "Debug Main Package",
            "type": "go",
            "request": "launch",
            "mode": "debug", 
            "program": "${workspaceFolder}/main.go",
            "env": {"GOFLAGS": "-v"},
            "args": [],
            "showLog": true
        },
        {
            "name": "Debug Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "env": {"GOFLAGS": "-v"},
            "args": ["-v"],
            "showLog": true
        }
    ]
}